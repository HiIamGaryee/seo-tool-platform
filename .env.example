# --- Crawl4AI extraction ----------------------------------------------------
CRAWL4AI_ENABLED=true
CRAWL4AI_MAX_PAGES=10
CRAWL4AI_PAGE_TIMEOUT=30000
CRAWL4AI_CONCURRENCY=3
CRAWL4AI_CACHE_HOURS=6
CRAWL4_AI_BASE_DIRECTORY=

# --- Gemini (OPTIONAL, backend only) ----------------------------------------
# Used only as a Crawl4AI extraction fallback when deterministic HTML parsing
# finds nothing. It is never used to invent domain names, and the key must
# never be exposed to the browser.
CRAWL4AI_USE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3-flash-preview

# --- Similar Domain Discovery ----------------------------------------------
# Centralized TLD expansion list. Nothing hardcodes TLDs outside of this.
DOMAIN_DISCOVERY_TLDS=.com,.net,.org,.co,.io,.ai,.tech,.xyz,.online,.site,.info
SIMILAR_DOMAIN_MAX_GENERATED=300
SIMILAR_DOMAIN_MAX_VERIFIED=200
SIMILAR_DOMAIN_RESULT_LIMIT=30
SIMILAR_DOMAIN_SEO_ENRICH_LIMIT=60
# Candidates scoring below this are dropped before they reach the results.
SIMILAR_DOMAIN_MIN_SIMILARITY=55

# Ranking weights. Normalized automatically, so they need not sum to 1.
SIMILAR_RANK_WEIGHT_SIMILARITY=0.45
SIMILAR_RANK_WEIGHT_LIFECYCLE=0.30
SIMILAR_RANK_WEIGHT_SEO=0.25

# --- RDAP / WHOIS verification ---------------------------------------------
DOMAIN_RDAP_CONCURRENCY=10
DOMAIN_RDAP_TIMEOUT=15
DOMAIN_RDAP_MAX_RETRIES=3
# Minimum seconds between calls to one RDAP host. Raising it is polite to the
# registry; lowering it makes a 200-candidate run finish sooner.
DOMAIN_RDAP_MIN_HOST_INTERVAL=0.6
RDAP_CACHE_HOURS=24
# Port-43 WHOIS fallback, used only for TLDs that publish no RDAP endpoint.
# The registry's WHOIS host is discovered through IANA, never guessed.
DOMAIN_MONITOR_WHOIS_FALLBACK=1

# --- Debugging --------------------------------------------------------------
# Verbose discovery stages in the backend log and in the browser console,
# plus the developer Debug panel in the UI. Leave this off in production.
DOMAIN_RADAR_DEBUG=false
# Backend-only. Dumps whole RDAP payloads into the server log. Very noisy.
DOMAIN_RADAR_RDAP_VERBOSE=false

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
# Mirrors DOMAIN_RADAR_DEBUG for the browser console. Never put a secret in a
# VITE_ variable: everything prefixed VITE_ is compiled into the bundle.
VITE_DOMAIN_RADAR_DEBUG=false
